# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of this marketing site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The main NextReach app (sign up / sign in). Every "Start free trial" and "Sign in" link goes here.
NEXT_PUBLIC_APP_URL=https://app.example.com
# .NET API base URL, for live pricing (server only).
NEXTREACH_API_URL=https://api.example.com
# Shared secret for POST /api/revalidate-pricing (header x-revalidate-secret). Use a long random value.
REVALIDATE_SECRET=replace-with-a-long-random-string

# Supabase project settings (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Bypasses Row Level Security. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Scripts and DB tests only (migrations, seed, types, RLS tests); never read by the app.
# Use the Session pooler string (Project Settings → Database → Connection string → Session pooler).
# URL-encode special characters in the password (e.g. @ → %40).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Resend (optional). Without a key, emails are logged to the server console.
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM="NextReach <hello@yourdomain.com>"

# Cloudflare Turnstile (optional). Both keys are needed to enable it.
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Optional analytics: your Umami Cloud website ID. Leave empty to disable analytics and the notice.
# When set, visitors are asked first; the Umami script loads only after they accept.
NEXT_PUBLIC_ANALYTICS_ID=
